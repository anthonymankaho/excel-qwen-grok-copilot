{
  "name": "excel-qwen-grok-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "A local Excel task pane assistant powered by the Qwen API.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "office-addin-debugging start manifest.xml desktop --app excel --no-debug --no-live-reload",
    "start:word": "office-addin-debugging start manifest.xml desktop --app word --no-debug --no-live-reload",
    "dev-server": "node server.mjs",
    "stop": "office-addin-debugging stop manifest.xml desktop",
    "check": "node --check server.mjs && node --check relay-core.mjs && node --check mcp-connectors.mjs && node --check extract-files.mjs && node --check worker.mjs && node --check public/agent-core.js && node --check public/taskpane.js",
    "store-assets": "node scripts/make-store-assets.mjs",
    "deploy:cloudflare": "npx wrangler deploy",
    "test": "node --test \"tests/*.test.mjs\"",
    "package": "node scripts/make-download-zip.mjs",
    "autostart": "node scripts/install-autostart.mjs",
    "autostart-remove": "node scripts/install-autostart.mjs --remove",
    "relay-ensure": "node scripts/relay-ensure.mjs",
    "relay-stop": "node scripts/relay-stop.mjs"
  },
  "devDependencies": {
    "office-addin-debugging": "^7.0.1"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.3",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "zod": "^4.6.7"
  }
}
